# SUSE BCI variant of v1.16-4.10/Dockerfile.
#
# Replaces the Sumologic Alpine base with registry.suse.com/bci/bci-base
# and installs ruby + fluentd + plugins via zypper and bundler.
# Built in parallel to the Alpine Dockerfile via .github/workflows/artifacts-suse.yaml
# and pushed as :v1.16-4.10-{base,filters,full}-suse tags on rancher-main.
#
# Why bci-base, not bci/ruby:
#   bci/ruby is optimized for running Ruby apps — its default SLE_BCI repo
#   is missing dev headers (libopenssl-3-devel, zlib-devel), git, and the
#   build toolchain we need to compile native gems. bci-base exposes the
#   full SLE_BCI package set including the -devel split packages.
#
# Known missing native libs (intentionally NOT installed here; tracked as TODOs):
#   - librdkafka / librdkafka-devel  → rdkafka gem (output plugin) will fail.
#     Plan: vendor librdkafka from source in the `full` stage.
#   - snappy / snappy-devel          → snappy gem skipped from `base` for now.
#   - libmaxminddb / -devel          → geoip2_c gem vendors its own copy,
#     bootstrapped via autoreconf at gem-install time. No system package
#     needed; just autoconf/automake/libtool/gawk in the toolchain.
#   - libGeoIP (legacy, not libmaxminddb) → required by `geoip-c` gem that
#     fluent-plugin-geoip depends on. Retired by MaxMind in 2018, not in
#     SLE_BCI. Vendored from source in the base stage (see below).
#   - tini                           → not in BCI; using dumb-init from gem
#     (`gem install dumb-init` ships a Ruby-launched init replacement) is not
#     suitable, so we exec entrypoint.sh directly with `exec` and accept that
#     PID 1 is bash. Acceptable for fluentd which manages its own children.

FROM registry.suse.com/bci/bci-base:latest AS base

# Strict mode in every RUN so missing packages or failing gem installs
# break the build immediately instead of producing a hollow image.
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

ARG RUBY_PKG_VERSION=3.4

# Match the Alpine image layout: all gems land under /usr/local/bundle and
# their binstubs (fluent-gem, fluentd, etc.) are on PATH. Without this,
# zypper-installed ruby on bci-base puts gems under /usr/lib64/ruby/gems/3.4.0
# and binstubs in a directory PATH doesn't see, so `fluent-gem` is missing
# and the chart/operator's path assumptions break.
ENV GEM_HOME=/usr/local/bundle
ENV BUNDLE_PATH=/usr/local/bundle
ENV PATH=/usr/local/bundle/bin:$PATH

RUN set -eux \
 && zypper -n refresh \
 && zypper -n install --no-recommends \
        ruby${RUBY_PKG_VERSION} \
        ruby${RUBY_PKG_VERSION}-devel \
        ca-certificates ca-certificates-mozilla \
        libopenssl-3-devel zlib-devel libyaml-devel \
        gcc gcc-c++ make tar gzip xz git curl patch \
        automake autoconf libtool gawk \
 && zypper clean -a \
 && ln -sf $(command -v ruby.ruby${RUBY_PKG_VERSION} 2>/dev/null || command -v ruby) /usr/local/bin/ruby \
 && ln -sf $(command -v gem.ruby${RUBY_PKG_VERSION} 2>/dev/null  || command -v gem)  /usr/local/bin/gem \
 && mkdir -p /usr/local/bundle/bin \
 && ruby --version \
 && gem --version

# Vendor MaxMind's legacy libGeoIP from source — required by the geoip-c
# gem that fluent-plugin-geoip pulls in. The library was retired by
# MaxMind in 2018 (superseded by libmaxminddb) and is not in any SUSE
# repo. The 1.6.12 release is the last and is what Alpine's geoip-dev
# package wraps. Build is ~15s, adds <2 MB to the image. ldconfig picks
# up /usr/local/lib via /etc/ld.so.conf.d/usrlocal.conf (already shipped
# by bci-base via glibc).
RUN set -eux \
 && cd /tmp \
 && curl -fsSL -o geoip.tar.gz https://github.com/maxmind/geoip-api-c/releases/download/v1.6.12/GeoIP-1.6.12.tar.gz \
 && tar xf geoip.tar.gz \
 && cd GeoIP-1.6.12 \
 && ./configure --prefix=/usr/local --disable-static \
 && make -j"$(nproc)" \
 && make install \
 && echo /usr/local/lib > /etc/ld.so.conf.d/usrlocal.conf \
 && ldconfig \
 && cd / && rm -rf /tmp/GeoIP-1.6.12 /tmp/geoip.tar.gz

RUN set -eux \
 && groupadd -g 101 -r fluent \
 && useradd -u 100 -r -g fluent -d /fluentd -s /sbin/nologin fluent \
 && mkdir -p /fluentd/log /fluentd/etc /fluentd/plugins /buffers \
 && chown -R fluent:fluent /fluentd /buffers

# Core fluentd + plugins that Sumo's pre-built bundle used to ship for us.
# Versions track what 1.16.5-sumo-0-alpine carried so the operator-generated
# config keeps matching plugin APIs. Native gems (oj, nio4r, google-protobuf)
# compile here; snappy/rdkafka/geoip are deferred (missing libs, see header).
RUN set -eux \
 && echo 'gem: --no-document' >> /etc/gemrc \
 && gem install bundler:2.5.6 \
 # Diagnostic: surface where gem actually installs things, so future failures
 # don't require re-running CI to find out.
 && gem env \
 && gem install \
        bigdecimal:1.4.4 \
        oj:3.16.1 \
        google-protobuf:3.25.5 \
        nio4r:2.7.3 \
        webrick:1.8.2 \
        fluentd:1.16.5 \
        fluent-plugin-prometheus:2.2.1 \
        fluent-plugin-kubernetes_metadata_filter:3.4.0 \
        fluent-plugin-rewrite-tag-filter:2.4.0 \
        fluent-plugin-record-modifier:2.2.0 \
        fluent-plugin-concat:2.5.0 \
        fluent-plugin-detect-exceptions:0.0.16 \
        fluent-plugin-multi-format-parser:1.1.0 \
        fluent-plugin-grok-parser:2.6.2 \
        fluent-plugin-systemd:1.0.5 \
        specific_install:0.3.8 \
 # Locate fluent-gem regardless of where rubygems decided to install
 # binstubs (GEM_HOME ENV doesn't always win against compiled-in defaults
 # on SUSE-packaged ruby). Symlink it into /usr/local/bin so subsequent
 # `fluent-gem` invocations resolve via PATH.
 && FLUENT_GEM=$(find / -name 'fluent-gem' -type f -executable 2>/dev/null | grep -v '/proc/' | head -1) \
 && echo "Found fluent-gem at: ${FLUENT_GEM:-NOT FOUND}" \
 && [ -n "$FLUENT_GEM" ] \
 && ln -sf "$FLUENT_GEM" /usr/local/bin/fluent-gem \
 && fluent-gem --version \
 # Same trick for the bundle dir — discover the real GEM_HOME and symlink
 # /usr/local/bundle to it so the rest of the Dockerfile's hard-coded path
 # assumptions keep working.
 && REAL_GEM_DIR=$(gem env gemdir) \
 && echo "Real gem dir: $REAL_GEM_DIR" \
 && if [ "$REAL_GEM_DIR" != "/usr/local/bundle" ]; then \
        rm -rf /usr/local/bundle ; \
        ln -sf "$REAL_GEM_DIR" /usr/local/bundle ; \
    fi \
 && fluent-gem specific_install -l https://github.com/ManageIQ/kubeclient.git --ref 054bff2c5e31a555004be2b3c4d32fb9dc5e6a0f \
 && fluent-gem specific_install -l https://github.com/kube-logging/fluent-plugin-label-router.git --ref namespace-label \
 && chown -R fluent:fluent /usr/local/bundle/ 2>/dev/null || true \
 && rm -rf /usr/local/bundle/cache/* 2>/dev/null || true \
 && find -L /usr/local/bundle -name '*.o' -delete 2>/dev/null || true

# SUSE ruby names binstubs *.ruby3.4; create plain aliases so the
# Alpine-compatible entrypoint (exec fluentd ...) works unchanged.
RUN find /usr/local/bundle/bin -name '*.ruby3.4' | \
    while read f; do ln -sf "$f" "${f%.ruby3.4}"; done

WORKDIR /fluentd

COPY fluent.conf /fluentd/etc/
COPY entrypoint.sh /bin/
COPY healthy.sh /bin/

ENV FLUENTD_CONF="fluent.conf"
ENV LD_PRELOAD=""
EXPOSE 24224 5140

USER fluent

# No tini in BCI repos; bash as PID 1 is acceptable for fluentd which
# manages its own children. Re-evaluate if signal handling regresses.
ENTRYPOINT ["/bin/entrypoint.sh"]
CMD ["fluentd"]

### Image with all the filters
FROM base AS filters

ADD ./filters/Gemfile /Gemfile.filters
ADD ./filters/Gemfile.lock /Gemfile.filters.lock

USER root

ENV BUNDLE_WITHOUT="output,test,development"

# Build deps already in base layer (we don't try to remove them between
# stages — image size hit is small vs. the iteration speed win).
RUN set -eux \
 && touch /etc/gemrc \
 && fluent-gem install --file /Gemfile.filters \
 && chown -R fluent:fluent /usr/local/bundle \
 && rm -rf /usr/local/bundle/cache/* \
 && find /usr/local/bundle -name '*.o' -delete

USER fluent

### Image with all the filters and outputs
FROM filters AS full

ADD ./outputs/Gemfile /Gemfile.outputs
ADD ./outputs/Gemfile.lock /Gemfile.outputs.lock

USER root

# TODO: rdkafka gem here will fail until we vendor librdkafka from source
# or add it from an OBS repo. Tracked in fluentd/RANCHER.md.
RUN set -eux \
 && touch /etc/gemrc \
 && fluent-gem specific_install -l https://github.com/kube-logging/fluent-plugin-gcs.git --ref ad6a7cb0f166e2c1648954a928e1e9b8cdcbf93d \
 && fluent-gem specific_install -l https://github.com/kube-logging/fluent-plugin-syslog_rfc5424.git --ref 4ab9f7df3757b0e31e4bc209acab05a518efdce3 \
 && fluent-gem specific_install -l https://github.com/kube-logging/fluent-plugin-elasticsearch.git --ref f711c4322e37852a83caab0385ba4567031eb9ab \
 && fluent-gem install --file /Gemfile.outputs \
 && chown -R fluent:fluent /usr/local/bundle \
 && rm -rf /usr/local/bundle/cache/* \
 && find /usr/local/bundle -name '*.o' -delete

USER fluent
